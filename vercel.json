{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth/[...auth]" },
    { "source": "/api/pause/activities/:id", "destination": "/api/pause/activities?id=:id" },
    { "source": "/api/plans/:id", "destination": "/api/plans?id=:id" },
    { "source": "/api/feedback/:id", "destination": "/api/feedback?id=:id" },
    { "source": "/((?!api/|@)[^.]*)", "destination": "/index.html" }
  ],
  "git": { "deploymentEnabled": { "flare/*": false, "dependabot/**": false } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}
