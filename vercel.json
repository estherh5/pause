{
  "ignoreCommand": "git cat-file -e ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}^{commit} 2>/dev/null || exit 1; git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- ':(top)' ':(top,exclude).github/' ':(top,exclude)tasks/' ':(top,exclude,glob)**/*.md'",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth/[...auth]" },
    { "source": "/api/pause/activities/:id", "destination": "/api/pause/activities?id=:id" },
    { "source": "/api/plans/:id", "destination": "/api/plans?id=:id" },
    { "source": "/api/feedback/:id", "destination": "/api/feedback?id=:id" },
    { "source": "/((?!api/|@)[^.]*)", "destination": "/index.html" }
  ],
  "git": { "deploymentEnabled": false },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}
