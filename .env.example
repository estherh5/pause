# ── Auth (crystalprism.io SSO ring) ─────────────────────────────────────
# Shared across every ring app — same value everywhere. openssl rand -base64 32
AUTH_SECRET="shared-ring-secret-32+chars"
# Google OAuth client (redirect: https://pause.crystalprism.io/api/auth/callback/google)
AUTH_GOOGLE_ID="...apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="..."
# The owner's Google email — full read/write. Lowercased on compare.
OWNER_EMAIL="hoffman.esther@gmail.com"

# ── Ring session check ──────────────────────────────────────────────────
# Shared ring service secret; lib/ring-session-check.ts checkRingSession uses it to revoke sessions after a ring password change. Must be at least 32 characters (lib/ring-session-check.ts enforces it). Unset or too short = every session passes.
RING_SERVICE_SECRET=

# ── Sharing invites (Resend) ────────────────────────────────────────────
RESEND_API_KEY="re_..."
# EMAIL_FROM: local override only; never set on Vercel

# ── Inbound feedback replies (api/inbound/feedback.ts) ─────────────────
# Signs the per-feedback Reply-To (reply+a.<id>.<hmac>@domain) on admin reply
# emails. Unset = replies go out without a Reply-To. openssl rand -hex 32
FEEDBACK_REPLY_SECRET=
# Inbox domain for that Reply-To. Defaults to crystalprism.io (the apex; it has the MX).
FEEDBACK_REPLY_DOMAIN=
# Resend webhook signing secret (whsec_...) for the email.received webhook at
# https://pause.crystalprism.io/api/inbound/feedback. Unset on production = 401 every post.
RESEND_WEBHOOK_SECRET=

# ── Database ───────────────────────────────────────────────────────────
# Leave these UNSET for local dev — the app falls back to ./local.db.
# In production, point at your Turso database:
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"


# ── flare error monitoring ─────────────────────────────────────────────
FLARE_URL=
FLARE_KEY=
VITE_FLARE_URL=
VITE_FLARE_KEY=
